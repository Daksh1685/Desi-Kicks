# ==============================================================================
# CRAFTYOURSOLE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in real values before running or deploying.
# Never commit .env to source control — it contains secrets.
# In production, pass these as Cloud Build substitutions / Secret Manager secrets.

# --- FIREBASE CONFIGURATION (Auth, Firestore, Storage, Analytics) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- SUPABASE CONFIGURATION (optional PostgreSQL alternative) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- PAYMENT GATEWAY ---
VITE_RAZORPAY_KEY_ID=

# --- APP CONFIGURATION ---
VITE_APP_NAME="CraftYourSole"
VITE_APP_URL="https://craftyoursole.in"

# --- FEATURE FLAGS ---
# Set to "true" to show the maintenance screen to all non-admin visitors
VITE_MAINTENANCE_MODE=false

