# ==============================================================================
# DESI-KICKS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Note: The app runs in Full Mock Mode by default if these variables are empty.
# When you are ready to connect Firebase and Supabase, fill these in and rename to .env.

# --- SUPABASE CONFIGURATION (PostgreSQL DB & Image Storage) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- FIREBASE CONFIGURATION (Google OAuth & Auth SDK) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- APP CONFIGURATION ---
VITE_APP_NAME="Desi-Kicks"
VITE_APP_URL="http://localhost:5173"

